@echo off
chcp 949 >nul
title Realtime Alert Hub 2.1 (멀티유저 통합 관제 포털)
cd /d "%~dp0"

echo ========================================================
echo  Realtime Alert Hub 2.1 (멀티유저 통합 관제 포털) 가동 중...
echo ========================================================
echo  포트 8000(사용 중이면 8001~)에서 6대 실시간 알리미가 시작됩니다.
echo  - 고속버스 (KOBUS) 빈자리 알리미
echo  - KTX / SRT 열차 취소표 알리미
echo  - CGV IMAX / 메가박스 특별관 잔여석 알리미
echo  - 제주 / 일본 특가 항공권 알리미
echo  - 시립대 수강신청 빈자리 알리미
echo  - 시립대 중앙도서관 열람실 및 공지사항 알리미
echo.
echo  [호스트 로그인] 관리자 키는 아래 서버 로그에 출력됩니다.
echo  외부 공개는 대시보드 - 통합 관제 - 호스트 패널 - [터널 시작]
echo ========================================================
echo.

python hub_server.py

if %ERRORLEVEL% NEQ 0 (
    echo.
    echo [오류] 허브 서버 실행 중 문제가 발생했습니다. Python 설치 상태를 확인해주세요.
    pause
)
